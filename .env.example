# Where the Next.js server reaches the backend (server-side fetches and the /api proxy).
FRAPPE_URL=http://127.0.0.1:8030
SOCKETIO_URL=http://localhost:9030
# The Frappe site name: socket.io uses it as the namespace.
NEXT_PUBLIC_SITE_NAME=fieldpro.localhost
# Where managers open ERPNext Desk (the landing page links to it).
NEXT_PUBLIC_DESK_URL=http://localhost:8030

# Optional: web push through Firebase Cloud Messaging. Leave blank and the app runs without push.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
